# EasyTier 自定义镜像的运行配置
#
# 用法：
#   cp .env.example .env   然后按需修改
#   docker compose up -d
#
# 注意：.env 里含网络密钥，不要提交到仓库（.env 已被 .gitignore 忽略）。

# ============================================================================
# web 面板（用本库镜像，容器内跑 easytier-web-embed）
# ============================================================================

# web 与 core 用的是同一个本库镜像，所以镜像名由 ET_IMAGE_OWNER + ET_IMAGE_TAG
# 决定（见下面 core 段）。web 与 core 必须配套：官方镜像里的 web 不认本库
# core 的 PersistedConfigService，面板改的配置落不到 core。
ET_IMAGE_OWNER=ldxw

# 接入用的用户名，同时也当作 core 的 config-server token。
# core 的 --config-server URL 最后一段就是这个值，web 侧靠它认设备。
# web 首次接入会自动建同名账号（compose 里 ET_ALLOW_AUTO_CREATE_USER 默认 true）。
ET_WEB_USER=admin

# config-server 协议与端口，core 通过它注册、取配置。
# 协议可用 udp / tcp / ws，默认 udp。
ET_WEB_PROTOCOL=udp
ET_CONFIG_SERVER_PORT=22020

# REST API + Web 面板端口（宿主机侧）。
# compose 里不设 ET_WEB_SERVER_PORT，前端与 REST 共用同一个端口。
ET_WEB_API_PORT=11211

# web 数据库落盘位置（容器内路径），默认 /app/et.db，已挂持久卷。
# ET_WEB_DB=/app/et.db

# 允许用 token 自动建号：首次接入 core 时没有账号会先建一个。
# ET_ALLOW_AUTO_CREATE_USER=true
# 关闭注册页面：只允许已存在的账号登录。
# ET_DISABLE_REGISTRATION=true

# OIDC：本版只有 client secret 有 env 支持，issuer / client_id /
# redirect_url / frontend_base_url 必须命令行传。一旦传了其中任意一个，
# web 会走 split-deploy 强制校验并退出。默认不配。
# 注意 env 名没有 ET_ 前缀（源码 easytier-web/src/restful/oidc.rs:135）。
# OIDC_CLIENT_SECRET=

# ============================================================================
# core（本库镜像 ghcr.io/ldxw/easytier-custom）
# ============================================================================

# 本库镜像 tag，对应 docker-custom.yml 构建出来的那个。
ET_IMAGE_TAG=dev

# --- 单节点模式（docker compose --profile standalone up -d easytier-standalone）---

# 网络名，同一网络的节点必须一致
ET_NETWORK_NAME=my-network

# 网络密钥，节点之间用它加密通信
ET_NETWORK_SECRET=please-change-me

# 要连接的节点，逗号分隔。例：tcp://1.2.3.4:11010,udp://5.6.7.8:11010
# ET_PEERS=

# 本机虚拟网卡地址，例：10.144.144.1
# ET_IPV4=

# 出口节点，逗号分隔。例：tcp://1.2.3.4:11010
# ET_EXIT_NODES=

# 手工指定监听，逗号分隔。例：udp://0.0.0.0:11010,wg://0.0.0.0:11011
# ET_LISTENERS=

# 只做代理不做网关时：置为 true，并指定要代理的网段
# ET_NO_TUN=true
# ET_PROXY_NETWORKS=192.168.31.0/24

# 注意：上面这组 network-name / secret / peers / ipv4 / exit-nodes 只在
# 单节点模式（easytier-standalone）下生效。接了 web 的 easytier 服务走
# config-server，这组变量不会传给它。
# 本库 core 默认带 --config-dir=config.d，所以配置权威在 core 的本地 TOML。
# web 后台改配置会写进这个目录并即时生效，落点仍是本地 TOML 文件
# （详见 docker-compose.yaml 文件头第 2 条）。

# 节点名与 SNI
# ET_HOSTNAME=
# ET_SNI=            （只有本库镜像有 --sni，官方 v2.7.1 没有）

# ============================================================================
# core 通用（两个模式共用）
# ============================================================================

# --- 状态目录 ---
# machine id 落在这里，必须持久化，否则容器重建后身份漂移。
# 本版从不读 /etc/machine-id。
ET_STATE_DIR=/app/state

# --- 实例配置目录 ---
# 本库 core 的 --config-dir 默认就是 config.d，存在即表示 core 以本地配置为权威：
# web 后台改的配置会写进这个目录（不是下发到 web 的数据库），写出来只为语义清楚。
ET_CONFIG_DIR=/app/config.d

# --- RPC 管理口 ---
# 映射到宿主机的端口（容器内固定 15888，镜像健康检查依赖它）
ET_RPC_PORTAL_PORT=15888

# RPC 客户端白名单。默认值已放开全部，安全性靠端口只绑到宿主机 127.0.0.1。
# 要在局域网内管理，改成具体网段，例如：192.168.1.0/24
# ET_RPC_PORTAL_WHITELIST=0.0.0.0/0,::/0

# --- 端口映射（宿主机:容器）---
# 只做单节点模式时需要；接 web 的模式下由对端节点连入，按需改宿主机侧端口。
# ET_PORT_11010=11010
# ET_PORT_11011=11011
# ET_PORT_11012=11012
# ET_PORT_11013=11013
# ET_PORT_11014=11014

# --- 日志 ---
# 日志级别：trace/debug/info/warn/error
ET_CONSOLE_LOG_LEVEL=info

# 文件日志目录（容器内路径），例：/app/logs
# ET_FILE_LOG_DIR=
# ET_FILE_LOG_LEVEL=info

# web 侧日志级别
# ET_WEB_CONSOLE_LOG_LEVEL=info
# ET_WEB_FILE_LOG_LEVEL=info
